generator client {
  provider = "prisma-client-js"
}

datasource db  {
    provider = "postgresql"
}
// ==========================================
// 1. BETTER AUTH
// ==========================================
model User {
  id                  String    @id @default(cuid())
  name                String?
  email               String    @unique
  emailVerified       Boolean   @default(false)
  image               String?
  password            String?
  
  investmentTargetPct Int       @default(20) 

  incomes             Income[]
  fixedExpenses       FixedExpense[]
  variableExpenses    VariableExpense[]
  investments         Investment[]
  assets              Asset[]
  debts               Debt[]
  sessions            Session[]
  accounts            Account[]

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  
  // Campos novos que o Better Auth exige agora
  idToken               String?
  issuer                String?
  
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

// ==========================================
// 2. MEU LEDGER 
// ==========================================

model Income {
  id        String   @id @default(cuid())
  userId    String
  name      String
  value     Decimal  @db.Decimal(10, 2)
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VariableExpense {
  id        String   @id @default(cuid())
  userId    String
  name      String
  value     Decimal  @db.Decimal(10, 2)
  category  String
  date      DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Investment {
  id        String   @id @default(cuid())
  userId    String
  name      String
  invested  Decimal  @db.Decimal(10, 2)
  current   Decimal  @db.Decimal(10, 2)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
}

model Asset {
  id        String   @id @default(cuid())
  userId    String
  name      String
  category  String
  value     Decimal  @db.Decimal(12, 2)
  
  debts     Debt[]

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Debt {
  id          String   @id @default(cuid())
  userId      String
  name        String
  category    String
  balance     Decimal  @db.Decimal(12, 2) 
  installment Decimal  @db.Decimal(10, 2) 

  assetId     String?
  asset       Asset?   @relation(fields: [assetId], references: [id], onDelete: SetNull)

  fixedExpenses FixedExpense[]

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FixedExpense {
  id           String   @id @default(cuid())
  userId       String
  name         String
  value        Decimal  @db.Decimal(10, 2)
  category     String
  dueDay       Int
  paid         Boolean  @default(false)
  
  linkedDebtId String?
  linkedDebt   Debt?    @relation(fields: [linkedDebtId], references: [id], onDelete: SetNull)

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}