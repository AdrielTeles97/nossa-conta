generator client {
  provider = "prisma-client-js"
}

datasource db  {
    provider = "postgresql"
}
// ==========================================
// 1. BETTER AUTH
// ==========================================
model Household {
  id         String   @id @default(cuid())
  name       String?
  inviteCode String   @unique @default(cuid())
  members    User[]
  incomes    Income[]
  fixedExpenses FixedExpense[]
  variableExpenses VariableExpense[]
  investments Investment[]
  assets     Asset[]
  debts      Debt[]
  categories Category[]
  cashBalances CashBalance[]
  debtPayments DebtPayment[]
  incomeAllocations IncomeAllocation[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("household")
}

model Category {
  id          String   @id @default(cuid())
  name        String
  type        String   // income | fixed | variable | asset | debt | investment | all
  householdId String?
  household   Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([householdId, name, type])
  @@index([householdId])
  @@map("category")
}

model User {
  id                  String    @id @default(cuid())
  name                String?
  email               String    @unique
  emailVerified       Boolean   @default(false)
  image               String?
  password            String?
  
  investmentTargetPct Int       @default(20) 

  householdId         String?
  household           Household? @relation(fields: [householdId], references: [id])

  incomes             Income[]
  fixedExpenses       FixedExpense[]
  variableExpenses    VariableExpense[]
  investments         Investment[]
  assets              Asset[]
  debts               Debt[]
  sessions            Session[]
  accounts            Account[]
  categories          Category[]
  cashBalances        CashBalance[]
  debtPayments        DebtPayment[]

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  
  // Campos novos que o Better Auth exige agora
  idToken               String?
  issuer                String?
  
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

// ==========================================
// 2. MEU LEDGER 
// ==========================================

model Income {
  id          String     @id @default(cuid())
  userId      String
  householdId String?
  name        String
  value       Decimal  @db.Decimal(10, 2)
  category    String   @default("Geral")
  isRecurring Boolean  @default(false)
  payDay      Int?     // dia que recebe (10, 30, 01)
  
  allocations IncomeAllocation[]

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  household   Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
  @@index([isRecurring])
  @@index([payDay])
}

model IncomeAllocation {
  id                 String   @id @default(cuid())
  householdId        String
  household          Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  incomeId           String
  income             Income   @relation(fields: [incomeId], references: [id], onDelete: Cascade)
  fixedExpenseId     String?
  fixedExpense       FixedExpense? @relation(fields: [fixedExpenseId], references: [id], onDelete: Cascade)
  variableExpenseId  String?
  variableExpense    VariableExpense? @relation(fields: [variableExpenseId], references: [id], onDelete: Cascade)
  amount             Decimal  @db.Decimal(10,2)
  period             String?  // YYYY-MM para travar por mês, null = global

  createdAt DateTime @default(now())

  @@unique([incomeId, fixedExpenseId, period])
  @@unique([incomeId, variableExpenseId, period])
  @@index([householdId])
  @@index([period])
  @@map("income_allocation")
}

model VariableExpense {
  id          String     @id @default(cuid())
  userId      String
  householdId String?
  name        String
  value       Decimal  @db.Decimal(10, 2)
  category    String
  date        DateTime @default(now())

  allocations IncomeAllocation[]

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  household   Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
}

model Investment {
  id          String     @id @default(cuid())
  userId      String
  householdId String?
  name        String
  invested    Decimal  @db.Decimal(10, 2)
  current     Decimal  @db.Decimal(10, 2)

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  household   Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@index([householdId])
}

model Asset {
  id          String     @id @default(cuid())
  userId      String
  householdId String?
  name        String
  category    String
  value       Decimal  @db.Decimal(12, 2)
  
  debts       Debt[]

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  household   Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
}

model Debt {
  id               String   @id @default(cuid())
  userId           String
  householdId      String?
  name             String
  category         String
  balance          Decimal  @db.Decimal(12, 2) 
  installment      Decimal  @db.Decimal(10, 2) 
  totalInstallments Int     @default(0)
  paidInstallments  Int     @default(0)
  dueDay           Int      @default(10)

  assetId     String?
  asset       Asset?   @relation(fields: [assetId], references: [id], onDelete: SetNull)

  fixedExpenses FixedExpense[]
  payments    DebtPayment[]

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  household   Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
}

model FixedExpense {
  id           String   @id @default(cuid())
  userId       String
  householdId  String?
  name         String
  value        Decimal  @db.Decimal(10, 2)
  category     String
  dueDay       Int
  paid         Boolean  @default(false)
  period       String?  // YYYY-MM quando não recorrente (ex: despesa de março lançada em agosto)
  isRecurring  Boolean  @default(true)
  
  linkedDebtId String?
  linkedDebt   Debt?    @relation(fields: [linkedDebtId], references: [id], onDelete: SetNull)

  allocations IncomeAllocation[]

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  household    Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([householdId])
  @@index([period])
}

model CashBalance {
  id          String   @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  period      String   // YYYY-MM
  amount      Decimal  @db.Decimal(12, 2)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([householdId, period])
  @@index([householdId])
  @@map("cash_balance")
}

model DebtPayment {
  id          String   @id @default(cuid())
  debtId      String
  debt        Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  competence  String   // YYYY-MM mês de referência (ex: 2026-09 vence 15/09 paga em 28/08)
  paidAt      DateTime @default(now())
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  @@unique([debtId, competence])
  @@index([debtId])
  @@index([householdId])
  @@index([competence])
  @@map("debt_payment")
}